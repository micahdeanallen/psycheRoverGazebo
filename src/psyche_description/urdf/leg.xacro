<?xml version="1.0"?>
<!--
  One 3-DOF leg: bracket (fixed) -> hip (LX-16A) -> femur (MG-996R) -> tibia (MG-996R).
  side = 1 for the left side (+y), -1 for the right side (-y).
  The hip joint frame is yawed so each leg's local +x points away from the body,
  which makes left and right legs mirror images with identical joint math.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="leg" params="name x side">

    <!-- Mounting bracket, rigidly attached to the frame -->
    <link name="${name}_bracket_link">
      <visual>
        <geometry><box size="${bracket_width} ${bracket_thickness} ${bracket_height}"/></geometry>
        <material name="bracket_pink"/>
      </visual>
      <collision>
        <geometry><box size="${bracket_width} ${bracket_thickness} ${bracket_height}"/></geometry>
      </collision>
      <xacro:box_inertial m="${bracket_mass}" x="${bracket_width}" y="${bracket_thickness}" z="${bracket_height}"/>
    </link>
    <joint name="${name}_bracket_joint" type="fixed">
      <parent link="chassis_link"/>
      <child link="${name}_bracket_link"/>
      <origin xyz="${x} ${side*(body_width/2 + bracket_thickness/2)} 0" rpy="0 0 0"/>
    </joint>

    <!-- Hip: LX-16A, rotates in the horizontal (xy) plane -->
    <joint name="${name}_hip_joint" type="revolute">
      <parent link="chassis_link"/>
      <child link="${name}_coxa_link"/>
      <origin xyz="${x} ${side*(body_width/2 + bracket_thickness)} ${hip_z}" rpy="0 0 ${side*pi/2}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-hip_limit}" upper="${hip_limit}" effort="${lx16a_effort}" velocity="${lx16a_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <!-- Coxa: Leg Connector A, carries MG-996R #1 at its outer end -->
    <link name="${name}_coxa_link">
      <visual>
        <origin xyz="${coxa_length/2} 0 0"/>
        <geometry><box size="${coxa_length} ${coxa_section_w} ${coxa_section_h}"/></geometry>
        <material name="servo_blue"/>
      </visual>
      <collision>
        <origin xyz="${coxa_length/2} 0 0"/>
        <geometry><box size="${coxa_length} ${coxa_section_w} ${coxa_section_h}"/></geometry>
      </collision>
      <xacro:box_inertial m="${coxa_mass}" x="${coxa_length}" y="${coxa_section_w}" z="${coxa_section_h}"
                          xyz="${coxa_length/2} 0 0"/>
    </link>

    <!-- Femur joint: MG-996R #1, rotates in the vertical plane. Positive = lift. -->
    <joint name="${name}_femur_joint" type="revolute">
      <parent link="${name}_coxa_link"/>
      <child link="${name}_femur_link"/>
      <origin xyz="${coxa_length} 0 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${-femur_limit}" upper="${femur_limit}" effort="${mg996r_effort}" velocity="${mg996r_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <!-- Femur: Leg Connector B, carries MG-996R #2 at its outer end -->
    <link name="${name}_femur_link">
      <visual>
        <origin xyz="${femur_length/2} 0 0"/>
        <geometry><box size="${femur_length} ${femur_section_w} ${femur_section_h}"/></geometry>
        <material name="servo_purple"/>
      </visual>
      <collision>
        <origin xyz="${femur_length/2} 0 0"/>
        <geometry><box size="${femur_length} ${femur_section_w} ${femur_section_h}"/></geometry>
      </collision>
      <xacro:box_inertial m="${femur_mass}" x="${femur_length}" y="${femur_section_w}" z="${femur_section_h}"
                          xyz="${femur_length/2} 0 0"/>
    </link>

    <!-- Tibia joint: MG-996R #2. The frame is pitched 90 deg so that at zero the
         foot points straight down. Positive = foot swings outward. -->
    <joint name="${name}_tibia_joint" type="revolute">
      <parent link="${name}_femur_link"/>
      <child link="${name}_tibia_link"/>
      <origin xyz="${femur_length} 0 0" rpy="0 ${pi/2} 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${-tibia_limit}" upper="${tibia_limit}" effort="${mg996r_effort}" velocity="${mg996r_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <!-- Tibia / foot segment. The sphere at the tip is the ground contact. -->
    <link name="${name}_tibia_link">
      <visual>
        <origin xyz="${tibia_length/2} 0 0"/>
        <geometry><box size="${tibia_length} ${tibia_section} ${tibia_section}"/></geometry>
        <material name="foot_grey"/>
      </visual>
      <visual>
        <origin xyz="${tibia_length} 0 0"/>
        <geometry><sphere radius="${foot_radius}"/></geometry>
        <material name="foot_grey"/>
      </visual>
      <collision>
        <origin xyz="${(tibia_length - foot_radius)/2} 0 0"/>
        <geometry><box size="${tibia_length - foot_radius} ${tibia_section} ${tibia_section}"/></geometry>
      </collision>
      <collision name="${name}_foot_collision">
        <origin xyz="${tibia_length} 0 0"/>
        <geometry><sphere radius="${foot_radius}"/></geometry>
      </collision>
      <xacro:box_inertial m="${tibia_mass}" x="${tibia_length}" y="${tibia_section}" z="${tibia_section}"
                          xyz="${tibia_length/2} 0 0"/>
    </link>

    <!-- Foot friction for Gazebo -->
    <gazebo reference="${name}_tibia_link">
      <mu1>${foot_mu}</mu1>
      <mu2>${foot_mu}</mu2>
    </gazebo>

  </xacro:macro>

</robot>
