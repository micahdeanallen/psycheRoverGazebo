<?xml version="1.0"?>
<!-- Inertia helpers for solid primitives. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Solid box, size x y z, centered at xyz. -->
  <xacro:macro name="box_inertial" params="m x y z xyz:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y + z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x + z*z)/12}" iyz="0"
               izz="${m*(x*x + y*y)/12}"/>
    </inertial>
  </xacro:macro>

</robot>
